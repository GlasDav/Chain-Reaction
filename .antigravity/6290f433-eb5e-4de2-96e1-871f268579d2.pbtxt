          text: "                        const dy = y - gp.y;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        const distSq = dx*dx + dy*dy;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        const dist = Math.sqrt(distSq || 1);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        if (dist < gp.radius + 30) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                            const pullPower = (1 - dist / (gp.radius + 30)) * 14;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                            drawX -= (dx / dist) * pullPower;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
