    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { playDetonate } from \'./audio\';\n\nexport type ParticleState = \'DRIFTING\' | \'EXPANDING\' | \'FROZEN\' | \'SHRINKING\' | \'DEAD\';\n\nexport interface Particle {\n    x: number;\n    y: number;\n    vx: number;\n    vy: number;\n    radius: number;\n    maxRadius: number;\n    color: string;\n    state: ParticleState;\n    timer: number;\n}\n\nexport interface Debris {\n    x: number;\n    y: number;\n    vx: number;\n    vy: number;\n    life: number;\n    color: string;\n}\n\nexport interface FloatingText {\n    x: number;\n    y: number;\n    text: string;\n    life: number;\n    color: string;\n}\n\nconst COLORS = [\'#FF0055\', \'#00FFCC\', \'#FFCC00\', \'#CC00FF\', \'#0066FF\'];\n\nconst EXPAND_FRAMES = 15;\nconst FREEZE_FRAMES = 120; // 2 seconds at 60fps\nconst SHRINK_FRAMES = 15;\n\nexport interface GameStats {\n    level: number;\n    targetPct: number;\n    totalRequired: number;\n    cleared: number;\n    combo: number;\n    maxCombo: number;\n    totalParticles: number;\n}\n\nexport class GameEngine {\n    canvas: HTMLCanvasElement;\n    ctx: CanvasRenderingContext2D;\n    width: number = 0;\n    height: number = 0;\n    dpr: number = 1;\n    \n    particles: Particle[] = [];\n    debris: Debris[] = [];\n    texts: FloatingText[] = [];\n    \n    level: number = 1;\n    targetPct: number = 70;\n    cleared: number = 0;\n    combo: number = 0;\n    maxCombo: number = 0;\n    totalDrifting: number = 0;\n\n    started: boolean = false;\n    tapped: boolean = false;\n    reqId: number = 0;\n    \n    onScoreUpdate: (stats: GameStats) => void;\n    onEndRound: (win: boolean, stats: GameStats) => void;\n\n    constructor(\n        canvas: HTMLCanvasElement, \n        onScoreUpdate: (stats: GameStats) => void,\n        onEndRound: (win: boolean, stats: GameStats) => void\n    ) {\n        this.canvas = canvas;\n        this.ctx = canvas.getContext(\'2d\', { alpha: false })!;\n        this.onScoreUpdate = onScoreUpdate;\n        this.onEndRound = onEndRound;\n        this.resize();\n        window.addEventListener(\'resize\', this.resize);\n    }\n\n    destroy() {\n        window.removeEventListener(\'resize\', this.resize);\n        cancelAnimationFrame(this.reqId);\n        this.started = false;\n    }\n\n    resize = () => {\n        const rect = this.canvas.parentElement!.getBoundingClientRect();\n        this.dpr = window.devicePixelRatio || 1;\n        this.width = rect.width;\n        this.height = rect.height;\n        this.canvas.width = this.width * this.dpr;\n        this.canvas.height = this.height * this.dpr;\n    };\n\n    getStats(): GameStats {\n        return {\n            level: this.level,\n            targetPct: this.targetPct,\n            totalRequired: Math.floor(this.totalDrifting * (this.targetPct / 100)),\n            cleared: this.cleared,\n            combo: this.combo,\n            maxCombo: this.maxCombo,\n            totalParticles: this.totalDrifting\n        };\n    }\n\n    startLevel(level: number) {\n        cancelAnimationFrame(this.reqId);\n        this.level = level;\n        this.targetPct = Math.min(90, 50 + (level - 1) * 5);\n        this.totalDrifting = 30 + level * 7;\n        this.cleared = 0;\n        this.combo = 0;\n        this.maxCombo = 0;\n        this.tapped = false;\n        this.particles = [];\n        this.debris = [];\n        this.texts = [];\n\n        for (let i = 0; i < this.totalDrifting; i++) {\n            this.particles.push({\n                x: Math.random() * this.width,\n                y: Math.random() * this.height,\n                vx: (Math.random() - 0.5) * 1.5,\n                vy: (Math.random() - 0.5) * 1.5,\n                radius: 4,\n                maxRadius: 35 + Math.random() * 15, // Large explosion radius\n                color: COLORS[Math.floor(Math.random() * COLORS.length)],\n                state: \'DRIFTING\',\n                timer: 0\n            });\n        }\n        \n        this.started = true;\n        this.onScoreUpdate(this.getStats());\n        this.loop();\n    }\n\n    handleInput(x: number, y: number) {\n        if (this.tapped || !this.started) return;\n        this.tapped = true;\n        \n        // Spawn trigger spark\n        this.particles.push({\n            x, y, vx: 0, vy: 0,\n            radius: 4, \n            maxRadius: 50,\n            color: \'#FFFFFF\',\n            state: \'EXPANDING\',\n            timer: 0\n        });\n        \n        this.onScoreUpdate(this.getStats());\n    }\n\n    private spawnExplosionJuice(p: Particle) {\n        // Spawn debris\n        for (let i = 0; i < 8; i++) {\n            const angle = Math.random() * Math.PI * 2;\n            const speed = 2 + Math.random() * 5;\n            this.debris.push({\n                x: p.x,\n                y: p.y,\n                vx: Math.cos(angle) * speed,\n                vy: Math.sin(angle) * speed,\n                life: 1.0,\n                color: p.color\n            });\n        }\n\n        // Spawn text\n        this.texts.push({\n            x: p.x,\n            y: p.y - 15,\n            text: `${this.combo}X!`,\n            life: 1.0,\n            color: \'#FFFFFF\'\n        });\n    }\n\n    update() {\n        // 1. Update particles\n        for (let p of this.particles) {\n            if (p.state === \'DRIFTING\') {\n                p.x += p.vx;\n                p.y += p.vy;\n                \n                // Border bounce (using css pixel dims)\n                if (p.x < p.radius) { p.x = p.radius; p.vx *= -1; }\n                else if (p.x > this.width - p.radius) { p.x = this.width - p.radius; p.vx *= -1; }\n                \n                if (p.y < p.radius) { p.y = p.radius; p.vy *= -1; }\n                else if (p.y > this.height - p.radius) { p.y = this.height - p.radius; p.vy *= -1; }\n            } else if (p.state === \'EXPANDING\') {\n                p.radius += (p.maxRadius - 4) / EXPAND_FRAMES;\n                if (p.radius >= p.maxRadius) {\n                    p.radius = p.maxRadius;\n                    p.state = \'FROZEN\';\n                    p.timer = FREEZE_FRAMES;\n                }\n            } else if (p.state === \'FROZEN\') {\n                p.timer--;\n                if (p.timer <= 0) {\n                    p.state = \'SHRINKING\';\n                }\n            } else if (p.state === \'SHRINKING\') {\n                p.radius -= p.maxRadius / SHRINK_FRAMES;\n                if (p.radius <= 0.1) {\n                    p.state = \'DEAD\';\n                }\n            }\n        }\n\n        // 2. Clear dead particles\n        this.particles = this.particles.filter(p => p.state !== \'DEAD\');\n\n        // 3. Collision checks (Drifting vs Explosions)\n        const explosives = this.particles.filter(p => \n            p.state === \'EXPANDING\' || p.state === \'FROZEN\' || p.state === \'SHRINKING\'\n        );\n\n        let didClear = false;\n\n        for (let p1 of this.particles) {\n            if (p1.state !== \'DRIFTING\') continue;\n            \n            for (let exp of explosives) {\n                // simple distance check\n                const dx = p1.x - exp.x;\n                const dy = p1.y - exp.y;\n                const distSq = dx*dx + dy*dy;\n                const targetDist = p1.radius + exp.radius;\n                \n                if (distSq < targetDist * targetDist) {\n                    p1.state = \'EXPANDING\';\n                    p1.vx = 0;\n                    p1.vy = 0;\n                    p1.radius = 4; // Start expansion from min size\n                    \n                    this.cleared++;\n                    this.combo++;\n                    this.maxCombo = Math.max(this.combo, this.maxCombo);\n                    \n                    playDetonate(this.combo);\n                    this.spawnExplosionJuice(p1);\n                    didClear = true;\n                    break; // Only blow up once per frame\n                }\n            }\n        }\n\n        if (didClear) {\n            this.onScoreUpdate(this.getStats());\n        }\n\n        // 4. Update Debris\n        for (let d of this.debris) {\n            d.x += d.vx;\n            d.y += d.vy;\n            d.life -= 0.03;\n        }\n        this.debris = this.debris.filter(d => d.life > 0);\n\n        // 5. Update Texts\n        for (let t of this.texts) {\n            t.y -= 0.5;\n            t.life -= 0.015;\n        }\n        this.texts = this.texts.filter(t => t.life > 0);\n    }\n\n    draw() {\n        const { ctx, dpr } = this;\n        \n        // Solid dark background for crisp rendering\n        ctx.fillStyle = \'#0f172a\'; // slate-900\n        ctx.fillRect(0, 0, this.width * dpr, this.height * dpr);\n        \n        ctx.save();\n        ctx.scale(dpr, dpr);\n        \n        // Use additive blending for neon explosions\n        ctx.globalCompositeOperation = \'screen\';\n        \n        // Draw Particles\n        for (let p of this.particles) {\n            ctx.beginPath();\n            ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);\n            ctx.fillStyle = p.color;\n            ctx.shadowBlur = p.state === \'DRIFTING\' ? 3 : 15;\n            ctx.shadowColor = p.color;\n            ctx.fill();\n\n            // Core hot-white center for explosions\n            if (p.state === \'EXPANDING\' || p.state === \'FROZEN\' || p.state === \'SHRINKING\') {\n                ctx.beginPath();\n                ctx.arc(p.x, p.y, p.radius * 0.4, 0, Math.PI * 2);\n                ctx.fillStyle = \'#FFFFFF\';\n                ctx.shadowBlur = 0;\n                ctx.fill();\n            }\n        }\n\n        // Draw Debris\n        for (let d of this.debris) {\n            ctx.globalAlpha = Math.max(0, d.life);\n            ctx.beginPath();\n            ctx.arc(d.x, d.y, 2, 0, Math.PI * 2);\n            ctx.fillStyle = d.color;\n            ctx.shadowBlur = 5;\n            ctx.shadowColor = d.color;\n            ctx.fill();\n        }\n        \n        // Restore for crisp text (no additive blending needed)\n        ctx.globalCompositeOperation = \'source-over\';\n\n        // Draw Texts\n        for (let t of this.texts) {\n            ctx.globalAlpha = Math.max(0, t.life);\n            ctx.font = \'bold 24px sans-serif\';\n            ctx.textAlign = \'center\';\n            ctx.fillStyle = t.color;\n            ctx.shadowBlur = 4;\n            ctx.shadowColor = \'#000000\';\n            // Slight stroke for readability\n            ctx.lineWidth = 3;\n            ctx.strokeText(t.text, t.x, t.y);\n            ctx.fillText(t.text, t.x, t.y);\n        }\n\n        ctx.restore();\n    }\n\n    loop = () => {\n        if (!this.started) return;\n        \n        this.update();\n        this.draw();\n        \n        // Evaluate Win/Loss after all explosions are dead\n        if (this.tapped) {\n            const hasExplosives = this.particles.some(p => \n                p.state === \'EXPANDING\' || p.state === \'FROZEN\' || p.state === \'SHRINKING\'\n            );\n            \n            if (!hasExplosives) {\n                // Round over!\n                this.started = false;\n                const stats = this.getStats();\n                const objMissedCount = (this.totalDrifting - this.cleared);  // Unused technically but confirms logic\n                const didWin = this.cleared >= stats.totalRequired;\n                \n                // Allow a slight delay before showing the game over screen\n                setTimeout(() => {\n                    this.onEndRound(didWin, stats);\n                }, 500); \n                return;\n            }\n        }\n\n        this.reqId = requestAnimationFrame(this.loop);\n    }\n}"
    }
