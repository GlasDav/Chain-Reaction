        }
        lines {
          text: "                    const distSq = dx*dx + dy*dy;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    if (distSq < 130 * 130) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        const dist = Math.sqrt(distSq || 1);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        // Decay particles resist the gravity explosion well"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        const baseGravity = other.type === \'DECAY\' ? 0.12 : 0.45;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        const pullForce = (1 - dist / 130) * baseGravity;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        other.vx += (dx / dist) * pullForce;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        other.vy += (dy / dist) * pullForce;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
