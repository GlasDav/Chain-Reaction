  file_change {
    absolute_path_uri: "file:///src/App.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nexport default function App() {\n  return <div></div>;\n}"
      replacement_content: "import { useEffect, useRef, useState, PointerEvent } from \'react\';\nimport { GameEngine, GameStats } from \'./lib/engine\';\nimport { initAudio } from \'./lib/audio\';\nimport { Share2, Play, RotateCcw } from \'lucide-react\';\n\ntype Screen = \'START\' | \'GAME\' | \'ROUND_OVER\';\n\nexport default function App() {\n    const [screen, setScreen] = useState<Screen>(\'START\');\n    \n    // Core game stats persistence\n    const [level, setLevel] = useState(1);\n    const [totalScore, setTotalScore] = useState(0);\n    const [peakCombo, setPeakCombo] = useState(0);\n    \n    // Live update stats from engine\n    const [liveStats, setLiveStats] = useState<GameStats | null>(null);\n    const [didWinLast, setDidWinLast] = useState(false);\n    \n    const canvasRef = useRef<HTMLCanvasElement>(null);\n    const engineRef = useRef<GameEngine | null>(null);\n\n    const handleScoreUpdate = (stats: GameStats) => {\n        setLiveStats(stats);\n    };\n\n    const handleRoundEnd = (win: boolean, stats: GameStats) => {\n        setDidWinLast(win);\n        setPeakCombo(prev => Math.max(prev, stats.maxCombo));\n        if (win) {\n            setTotalScore(prev => prev + stats.cleared);\n        }\n        setScreen(\'ROUND_OVER\');\n    };\n\n    useEffect(() => {\n        if (screen === \'GAME\' && canvasRef.current) {\n            engineRef.current = new GameEngine(\n                canvasRef.current, \n                handleScoreUpdate, \n                handleRoundEnd\n            );\n            engineRef.current.startLevel(level);\n        }\n        \n        return () => {\n            if (engineRef.current) {\n                engineRef.current.destroy();\n                engineRef.current = null;\n            }\n        };\n    }, [screen, level]);\n\n    const startGame = () => {\n        initAudio(); // Satisfy browser requirements on user interaction\n        // If they died and hit retry, reset stats\n        if (screen === \'ROUND_OVER\' && !didWinLast) {\n            setLevel(1);\n            setTotalScore(0);\n            setPeakCombo(0);\n        } else if (screen === \'ROUND_OVER\' && didWinLast) {\n            setLevel(l => l + 1);\n        }\n        setScreen(\'GAME\');\n    };\n\n    const handleCanvasPointer = (e: PointerEvent<HTMLCanvasElement>) => {\n        if (!engineRef.current) return;\n        const rect = e.currentTarget.getBoundingClientRect();\n        // Since React pointer event coords relative to the window,\n        // subtract the canvas rect origin to get local CSS pixel coordinates\n        const x = (e.clientX - rect.left);\n        const y = (e.clientY - rect.top);\n        engineRef.current.handleInput(x, y);\n    };\n\n    const shareScore = () => {\n        const text = `I hit a ${peakCombo}x COMBO on Level ${level} of Chain Reaction! Can you beat it? \360\237\222\245`;\n        // Real logic wrapper to simulate viral ghost button functionality\n        if (navigator.clipboard) {\n            navigator.clipboard.writeText(text).then(() => {\n                alert(\"Score copied to clipboard! (Ghost Link Mock)\");\n            });\n        }\n    };\n\n    return (\n        <div className=\"flex items-center justify-center min-h-screen bg-black text-white selection:bg-none p-4 font-sans\">\n            {/* Main Application Window Container */}\n            <div className=\"w-full max-w-md h-[85vh] min-h-[600px] border border-slate-800 rounded-3xl overflow-hidden relative shadow-[0_0_80px_rgba(30,58,138,0.2)] bg-slate-900 flex flex-col\">\n                \n                {screen === \'START\' && (\n                    <div className=\"absolute inset-0 flex flex-col items-center justify-center p-8 text-center z-10 bg-slate-900/90 backdrop-blur-sm\">\n                        <h1 className=\"text-5xl font-black mb-2 tracking-tighter bg-gradient-to-br from-pink-500 via-purple-500 to-cyan-500 text-transparent bg-clip-text drop-shadow-[0_0_15px_rgba(236,72,153,0.5)]\">\n                            CHAIN<br/>REACTION\n                        </h1>\n                        <p className=\"text-slate-400 mb-12\">One Tap. Infinite Chaos.</p>\n                        \n                        <button \n                            onClick={startGame}\n                            className=\"bg-white text-black px-8 py-4 rounded-full font-bold text-xl flex items-center gap-3 hover:scale-105 transition-transform shadow-[0_0_20px_rgba(255,255,255,0.3)] active:scale-95\"\n                        >\n                            <Play className=\"w-6 h-6 fill-black\" />\n                            TAP TO PLAY\n                        </button>\n                    </div>\n                )}\n\n                {/* HUD for active game */}\n                {screen === \'GAME\' && liveStats && (\n                    <div className=\"absolute top-0 left-0 w-full p-4 pointer-events-none z-10 flex justify-between items-start\">\n                        <div className=\"bg-slate-900/50 backdrop-blur-md px-4 py-2 rounded-xl border border-slate-700/50\">\n                            <div className=\"text-xs text-slate-400 font-bold tracking-wider\">LEVEL {liveStats.level}</div>\n                            <div className=\"text-xl font-bold\">\n                                {liveStats.cleared} <span className=\"text-sm font-normal text-slate-400\">/ {liveStats.totalRequired}</span>\n                            </div>\n                        </div>\n                        {liveStats.combo > 1 && (\n                            <div className=\"bg-pink-500/20 text-pink-400 border border-pink-500/30 backdrop-blur-md px-4 py-2 rounded-xl text-right animate-pulse\">\n                                <div className=\"text-xs font-bold tracking-wider\">COMBO</div>\n                                <div className=\"text-xl font-black\">{liveStats.combo}X</div>\n                            </div>\n                        )}\n                    </div>\n                )}\n\n                {/* State Tracking Toasts */}\n                {screen === \'GAME\' && liveStats && engineRef.current?.tapped && engineRef.current?.started && (\n                     <div className=\"absolute bottom-8 w-full text-center pointer-events-none z-10\">\n                        <div className=\"inline-block px-4 py-2 rounded-full bg-slate-800/80 backdrop-blur-sm text-sm font-medium text-slate-300 animate-pulse-fast border border-slate-700/50 box-shadow\">\n                            Watching reaction...\n                        </div>\n                     </div>\n                )}\n\n                {screen === \'GAME\' && liveStats && !engineRef.current?.tapped && (\n                     <div className=\"absolute bottom-8 w-full text-center pointer-events-none z-10\">\n                        <div className=\"inline-block px-4 py-2 rounded-full bg-slate-800/80 backdrop-blur-sm text-sm font-medium text-slate-300 border border-slate-700/50\">\n                            Tap anywhere to drop a spark!\n                        </div>\n                     </div>\n                )}\n\n                {screen === \'ROUND_OVER\' && liveStats && (\n                    <div className=\"absolute inset-0 flex flex-col items-center justify-center p-8 text-center z-10 bg-slate-900/95 backdrop-blur-lg\">\n                        <h2 className={`text-4xl font-black mb-2 ${didWinLast ? \'text-green-400 drop-shadow-[0_0_15px_rgba(74,222,128,0.5)]\' : \'text-red-500 drop-shadow-[0_0_15px_rgba(239,68,68,0.5)]\'}`}>\n                            {didWinLast ? \'LEVEL CLEARED!\' : \'FAILED!\'}\n                        </h2>\n                        \n                        <p className=\"text-slate-400 mb-8 max-w-[200px]\">\n                            {didWinLast \n                                ? `You triggered a massive reaction!` \n                                : `Target was ${liveStats.totalRequired}. You only hit ${liveStats.cleared}.`}\n                        </p>\n\n                        <div className=\"grid grid-cols-2 gap-4 w-full mb-10\">\n                            <div className=\"bg-slate-800 p-4 rounded-2xl border border-slate-700 font-mono\">\n                                <div className=\"text-xs text-slate-400\">CLEARED</div>\n                                <div className=\"text-2xl text-white\">{liveStats.cleared}</div>\n                            </div>\n                            <div className=\"bg-slate-800 p-4 rounded-2xl border border-slate-700 font-mono\">\n                                <div className=\"text-xs text-cyan-400\">PEAK COMBO</div>\n                                <div className=\"text-2xl text-white\">{peakCombo}X</div>\n                            </div>\n                        </div>\n\n                        <div className=\"flex flex-col w-full gap-4\">\n                            <button \n                                onClick={startGame}\n                                className=\"w-full bg-white text-black py-4 rounded-xl font-bold text-lg flex items-center justify-center gap-2 hover:bg-slate-200 active:scale-95 transition-all\"\n                            >\n                                {didWinLast ? (\n                                    <>\n                                        <Play className=\"w-5 h-5 fill-black\" /> NEXT LEVEL\n                                    </>\n                                ) : (\n                                    <>\n                                        <RotateCcw className=\"w-5 h-5\" /> TRY AGAIN\n                                    </>\n                                )}\n                            </button>\n                            \n                            <button \n                                onClick={shareScore}\n                                className=\"w-full bg-slate-800 text-white py-4 rounded-xl font-bold text-lg flex items-center justify-center gap-2 border border-slate-700 hover:bg-slate-700 active:scale-95 transition-all\"\n                            >\n                                <Share2 className=\"w-5 h-5\" /> SHARE GHOST LINK\n                            </button>\n                        </div>\n                    </div>\n                )}\n                \n                {/* The physics-enabled canvas layer - visibility controlled to preserve bounds without ref loss */}\n                <canvas \n                    ref={canvasRef} \n                    className=\"w-full h-full flex-grow block touch-none\"\n                    onPointerDown={handleCanvasPointer}\n                    style={{ visibility: screen === \'START\' ? \'hidden\' : \'visible\' }}\n                />\n            </div>\n        </div>\n    );\n}"
    }
