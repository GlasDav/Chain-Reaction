        }
        lines {
          text: "            ctx.strokeStyle = `rgba(250, 204, 21, ${0.1 + Math.sin(this.orbitAngle * 2) * 0.05})`;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
