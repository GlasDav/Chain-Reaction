      target_content: "    const pullSlotLever = () => {\n        if (slotSpinning || slotHasSpun || !earnedShardStats) return;\n        \n        setSlotSpinning(true);\n        setSlotHasSpun(false);\n        setSlotMultiplier(1.0);\n        setSlotPayoutMessage(\"\360\237\216\260 DRIFTING QUANTUM MUTATION CYLINDERS... \360\237\216\260\");\n        setShowPayoutBanner(false);\n        \n        const symbols = [\'\360\237\215\222\', \'\342\232\241\', \'\360\237\222\216\', \'\360\237\216\260\', \'\360\237\215\200\'];\n        let ticksCount = 0;\n\n        // Perform fast visual roll iterations\n        const spinInterval = setInterval(() => {\n            // Randomize three reel positions to sound authentic!\n            setSlotReels([\n                symbols[Math.floor(Math.random() * symbols.length)],\n                symbols[Math.floor(Math.random() * symbols.length)],\n                symbols[Math.floor(Math.random() * symbols.length)]\n            ]);\n            playSlotSpin();\n            ticksCount++;\n            if (ticksCount >= 12) {\n                clearInterval(spinInterval);\n                finishSlotLeverSpin();\n            }\n        }, 115);\n    };\n\n    const finishSlotLeverSpin = () => {\n        // High-tension weighted chance generator\n        const rand = Math.random() * 100;\n        let finalReels: string[] = [];\n        let multiplier = 1.0;\n        let msg = \"\";\n\n        if (rand < 7) {\n            finalReels = [\'\360\237\216\260\', \'\360\237\216\260\', \'\360\237\216\260\'];\n            multiplier = 5.0;\n            msg = \"\360\237\224\245 SUPERNOVA REACTOR 777! 5.0X REWARD JACKPOT! \360\237\224\245\";\n        } else if (rand < 20) {\n            finalReels = [\'\360\237\222\216\', \'\360\237\222\216\', \'\360\237\222\216\'];\n            multiplier = 3.0;\n            msg = \"\360\237\222\216 QUANTUM DIAMOND CASCADE! 3.0X REWARD JACKPOT! \360\237\222\216\";\n        } else if (rand < 40) {\n            finalReels = [\'\342\232\241\', \'\342\232\241\', \'\342\232\241\'];\n            multiplier = 2.0;\n            msg = \"\342\232\241 SPARK IMPULSE OVERDRIVE! 2.0X REWARD SPEED! \342\232\241\";\n        } else if (rand < 65) {\n            finalReels = [\'\360\237\215\222\', \'\360\237\215\222\', \'\360\237\215\222\'];\n            multiplier = 1.5;\n            msg = \"\360\237\215\222 MOLECULAR CHERRY EXPLOSION! 1.5X REWARD! \360\237\215\222\";\n        } else if (rand < 90) {\n            const chosenMajor = [\'\360\237\215\222\', \'\342\232\241\', \'\360\237\222\216\', \'\360\237\216\260\'][Math.floor(Math.random() * 4)];\n            const chosenOther = [\'\360\237\215\200\', \'\360\237\215\222\', \'\342\232\241\', \'\360\237\222\216\', \'\360\237\216\260\'].filter(x => x !== chosenMajor)[Math.floor(Math.random() * 4)];\n            finalReels = [chosenMajor, chosenMajor, chosenOther];\n            multiplier = 1.25;\n            msg = \"\342\232\241 NEAR-MISS CONVERGENCE SURGE! +1.25X SECURED SECURELY! \342\232\241\";\n        } else {\n            finalReels = [\'\360\237\215\222\', \'\342\232\241\', \'\360\237\215\200\'];\n            multiplier = 1.15;\n            msg = \"\360\237\224\213 REACTOR GRID STABILIZER: +1.15X BASE SECURED! \360\237\224\213\";\n        }\n\n        // Apply visual stop animations\n        setSlotReels([finalReels[0], \'\360\237\215\200\', \'\360\237\216\260\']);\n        playSlotStop();\n\n        setTimeout(() => {\n            setSlotReels([finalReels[0], finalReels[1], \'\360\237\215\200\']);\n            playSlotStop();\n        }, 220);\n\n        setTimeout(() => {\n            setSlotReels(finalReels);\n            setSlotMultiplier(multiplier);\n            setSlotPayoutMessage(msg);\n            setSlotSpinning(false);\n            setSlotHasSpun(true);\n            setShowPayoutBanner(true);\n\n            // Calculate final multiplied reward\n            const computedGained = Math.floor((earnedShardStats?.total || 100) * multiplier);\n            setShards(prev => prev + computedGained);\n            playSlotPayout(multiplier >= 3.0);\n        }, 440);\n    };"
      replacement_content: "    const pullSlotLever = () => {\n        if (slotSpinning || slotHasSpun || !earnedShardStats) return;\n        \n        setSlotSpinning(true);\n        setSlotHasSpun(false);\n        setSlotMultiplier(1.0);\n        setSlotPayoutMessage(\"\342\232\241 INJECTING PARTICLES & MEASURING STABLE HARVEST RESIDUE... \342\232\241\");\n        setShowPayoutBanner(false);\n        setReactorCharge(0);\n        \n        const symbols = [\'\360\237\247\254 DECAY\', \'\342\232\241 IONIC\', \'\360\237\222\240 PLAS\', \'\360\237\214\200 CRIT\', \'\342\230\200\357\270\217 SOLAR\'];\n        let ticksCount = 0;\n\n        // Perform fast visual roll iterations matching tactical resonance charge buildup\n        const spinInterval = setInterval(() => {\n            ticksCount++;\n            setReactorCharge(Math.min(100, Math.floor((ticksCount / 12) * 100)));\n            // Randomize three reel positions to sound authentic!\n            setSlotReels([\n                symbols[Math.floor(Math.random() * symbols.length)],\n                symbols[Math.floor(Math.random() * symbols.length)],\n                symbols[Math.floor(Math.random() * symbols.length)]\n            ]);\n            playSlotSpin();\n            if (ticksCount >= 12) {\n                clearInterval(spinInterval);\n                finishSlotLeverSpin();\n            }\n        }, 115);\n    };\n\n    const finishSlotLeverSpin = () => {\n        // High-tension weighted chance generator\n        const rand = Math.random() * 100;\n        let finalReels: string[] = [];\n        let multiplier = 1.0;\n        let msg = \"\";\n\n        if (rand < 7) {\n            finalReels = [\'\342\230\200\357\270\217 SOLAR\', \'\342\230\200\357\270\217 SOLAR\', \'\342\230\200\357\270\217 SOLAR\'];\n            multiplier = 5.0;\n            msg = \"\342\232\241 MULTIPLIER CRITICAL JACKPOT: 5.0X HARVEST CORE SECURITISED! \342\232\241\";\n        } else if (rand < 20) {\n            finalReels = [\'\360\237\214\200 CRIT\', \'\360\237\214\200 CRIT\', \'\360\237\214\200 CRIT\'];\n            multiplier = 3.0;\n            msg = \"\360\237\214\200 HYPER-VELOCITY COMPRESSION CASCADE: 3.0X DIRECT PAYOUT GOAL! \360\237\214\200\";\n        } else if (rand < 40) {\n            finalReels = [\'\360\237\222\240 PLAS\', \'\360\237\222\240 PLAS\', \'\360\237\222\240 PLAS\'];\n            multiplier = 2.0;\n            msg = \"\360\237\222\240 PLASMA STABILITY OVERCHARGE INDEX: 2.0X NET FORCE RATIO! \360\237\222\240\";\n        } else if (rand < 65) {\n            finalReels = [\'\342\232\241 IONIC\', \'\342\232\241 IONIC\', \'\342\232\241 IONIC\'];\n            multiplier = 1.5;\n            msg = \"\342\232\241 ION BEAM INJECTOR STABILIZED: 1.5X SHARD FLOW ACCORDED! \342\232\241\";\n        } else if (rand < 90) {\n            const chosenMajor = [\'\342\232\241 IONIC\', \'\360\237\222\240 PLAS\', \'\360\237\214\200 CRIT\', \'\342\230\200\357\270\217 SOLAR\'][Math.floor(Math.random() * 4)];\n            const chosenOther = [\'\360\237\247\254 DECAY\', \'\342\232\241 IONIC\', \'\360\237\222\240 PLAS\', \'\360\237\214\200 CRIT\', \'\342\230\200\357\270\217 SOLAR\'].filter(x => x !== chosenMajor)[Math.floor(Math.random() * 4)];\n            finalReels = [chosenMajor, chosenMajor, chosenOther];\n            multiplier = 1.25;\n            msg = \"\360\237\224\256 NEAR-MISS QUANTUM TUNNELING FLUX: +1.25X SHARDS REOVERCLOCKED! \360\237\224\256\";\n        } else {\n            // Three unmatching symbols\n            finalReels = [\'\342\232\241 IONIC\', \'\360\237\222\240 PLAS\', \'\360\237\247\254 DECAY\'];\n            multiplier = 1.15;\n            msg = \"\360\237\224\213 REACTOR GRID STABLE BASELINE: +1.15X RECHARGE MULTIPLIER SECURED! \360\237\224\213\";\n        }\n\n        // Apply visual stop animations left-to-right to build massive expectation tension\n        setSlotReels([finalReels[0], \'\360\237\247\254 DECAY\', \'\360\237\247\254 DECAY\']);\n        playSlotStop();\n\n        setTimeout(() => {\n            setSlotReels([finalReels[0], finalReels[1], \'\360\237\247\254 DECAY\']);\n            playSlotStop();\n        }, 220);\n\n        setTimeout(() => {\n            setSlotReels(finalReels);\n            setSlotMultiplier(multiplier);\n            setSlotPayoutMessage(msg);\n            setSlotSpinning(false);\n            setSlotHasSpun(true);\n            setShowPayoutBanner(true);\n            setReactorCharge(100);\n\n            // Calculate final multiplied reward\n            const computedGained = Math.floor((earnedShardStats?.total || 100) * multiplier);\n            setShards(prev => prev + computedGained);\n            playSlotPayout(multiplier >= 3.0);\n        }, 440);\n    };"
    }
