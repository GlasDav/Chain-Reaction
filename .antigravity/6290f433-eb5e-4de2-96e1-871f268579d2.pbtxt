    replacement_infos {
      original_chunk {
        target_content: "    startLevel(level: number, upgrades?: StoreUpgrades, activeTheme?: ParticleTheme) {\n        cancelAnimationFrame(this.reqId);\n        this.level = level;\n        if (upgrades) this.upgrades = upgrades;\n        if (activeTheme) this.activeTheme = activeTheme;\n\n        this.sparksTotal = 1 + (this.upgrades.extraSparks || 0);\n        this.sparksLeft = this.sparksTotal;\n\n        // Increase requirements dynamically at higher levels to make standard gameplay significantly harder!\n        this.targetPct = Math.min(92, 50 + (level - 1) * 3);\n        this.totalDrifting = 30 + level * 5;\n        this.cleared = 0;\n        this.combo = 0;\n        this.maxCombo = 0;\n        this.tapped = false;\n        \n        this.magnetActive = false;\n        this.maxMagnetFuel = 100 + (this.upgrades.maxMagnetFuel || 0) * 40; \n        this.magnetFuel = this.maxMagnetFuel;\n        this.orbitAngle = 0;\n\n        this.particles = [];\n        this.debris = [];\n        this.texts = [];\n        this.splitterSparks = [];\n\n        // DIFFICULTY UPGRADES: Scaling up velocity vectors and shrinking hitbox radius at higher levels\n        // Base starting velocity multiplier increases with level, making herding and timing much faster!\n        const speedScale = 1.35 + Math.min(2.1, (level - 1) * 0.16);\n        const radiusScale = Math.max(0.70, 1.0 - (level - 1) * 0.03);\n\n        const activeThemeName = this.activeTheme || \'STANDARD\';\n        const currentThemeColors = THEME_COLORS[activeThemeName] || THEME_COLORS.STANDARD;\n\n        for (let i = 0; i < this.totalDrifting; i++) {\n            // Special particle spawns: base is 15%. Volatility injector upgrade increases rate up to 25% each!\n            const specialFreq = 0.15 + (this.upgrades.specialSpawnRate || 0) * 0.05;\n            const randType = Math.random();\n            let pType: ParticleType = \'STANDARD\';\n            if (randType < specialFreq) {\n                pType = \'GRAVITY\';\n            } else if (randType < specialFreq * 2) {\n                pType = \'SPLITTER\';\n            }\n\n            const selectionColors = currentThemeColors[pType] || THEME_COLORS.STANDARD[pType];\n            const chosenColor = selectionColors[Math.floor(Math.random() * selectionColors.length)];\n\n            this.particles.push({\n                x: Math.random() * (this.width - 40) + 20,\n                y: Math.random() * (this.height - 40) + 20,\n                vx: (Math.random() - 0.5) * speedScale,\n                vy: (Math.random() - 0.5) * speedScale,\n                radius: (pType === \'STANDARD\' ? 4 : pType === \'GRAVITY\' ? 5 : 6) * radiusScale,\n                maxRadius: pType === \'STANDARD\' \n                    ? (32 + Math.random() * 10) \n                    : pType === \'GRAVITY\' ? 52 : 42, \n                color: chosenColor,\n                state: \'DRIFTING\',\n                type: pType,\n                timer: 0\n            });\n        }\n        \n        this.started = true;\n        this.onScoreUpdate(this.getStats());\n        this.loop();\n    }"
        replacement_content: "    startLevel(level: number, upgrades?: StoreUpgrades, activeTheme?: ParticleTheme) {\n        cancelAnimationFrame(this.reqId);\n        this.level = level;\n        if (upgrades) this.upgrades = upgrades;\n        if (activeTheme) this.activeTheme = activeTheme;\n\n        this.sparksTotal = 1 + (this.upgrades.extraSparks || 0);\n        this.sparksLeft = this.sparksTotal;\n\n        // Increase requirements dynamically at higher levels to make standard gameplay significantly harder!\n        this.targetPct = Math.min(95, 55 + (level - 1) * 4);\n        this.totalDrifting = 30 + level * 5;\n        this.cleared = 0;\n        this.combo = 0;\n        this.maxCombo = 0;\n        this.tapped = false;\n        \n        this.magnetActive = false;\n        this.maxMagnetFuel = 100 + (this.upgrades.maxMagnetFuel || 0) * 40; \n        this.magnetFuel = this.maxMagnetFuel;\n        this.orbitAngle = 0;\n\n        // Reset Reactor Turbulence\n        this.turbulenceActive = false;\n        this.turbulenceWarning = false;\n        this.turbulenceX = -200;\n        this.turbulenceTimer = 240 + Math.random() * 200; // Trigger ~6-8 seconds in\n\n        this.particles = [];\n        this.debris = [];\n        this.texts = [];\n        this.splitterSparks = [];\n\n        // DIFFICULTY UPGRADES: Scaling up velocity vectors and shrinking hitbox radius at higher levels\n        // Base starting velocity multiplier increases with level, making herding and timing much faster!\n        const speedScale = 1.35 + Math.min(2.1, (level - 1) * 0.18);\n        const radiusScale = Math.max(0.68, 1.0 - (level - 1) * 0.035);\n\n        const activeThemeName = this.activeTheme || \'STANDARD\';\n        const currentThemeColors = THEME_COLORS[activeThemeName] || THEME_COLORS.STANDARD;\n\n        // 1. Spawn clearable goal particles\n        for (let i = 0; i < this.totalDrifting; i++) {\n            // Special particle spawns: base is 15%. Volatility injector upgrade increases rate up to 25% each!\n            const specialFreq = 0.15 + (this.upgrades.specialSpawnRate || 0) * 0.05;\n            const randType = Math.random();\n            let pType: ParticleType = \'STANDARD\';\n            if (randType < specialFreq) {\n                pType = \'GRAVITY\';\n            } else if (randType < specialFreq * 2) {\n                pType = \'SPLITTER\';\n            }\n\n            const selectionColors = currentThemeColors[pType] || THEME_COLORS.STANDARD[pType];\n            const chosenColor = selectionColors[Math.floor(Math.random() * selectionColors.length)];\n\n            this.particles.push({\n                x: Math.random() * (this.width - 40) + 20,\n                y: Math.random() * (this.height - 40) + 20,\n                vx: (Math.random() - 0.5) * speedScale,\n                vy: (Math.random() - 0.5) * speedScale,\n                radius: (pType === \'STANDARD\' ? 4 : pType === \'GRAVITY\' ? 5 : 6) * radiusScale,\n                maxRadius: pType === \'STANDARD\' \n                    ? (32 + Math.random() * 10) \n                    : pType === \'GRAVITY\' ? 52 : 42, \n                color: chosenColor,\n                state: \'DRIFTING\',\n                type: pType,\n                timer: 0\n            });\n        }\n\n        // 2. Spawn additional non-detonatable/heat-sink Decay particles at level 2+\n        const decayCount = level < 2 ? 0 : Math.floor(this.totalDrifting * (0.08 + Math.min(0.20, (level - 2) * 0.03)));\n        for (let i = 0; i < decayCount; i++) {\n            const decayColors = currentThemeColors.DECAY || THEME_COLORS.STANDARD.DECAY;\n            const chosenColor = decayColors[Math.floor(Math.random() * decayColors.length)];\n            this.particles.push({\n                x: Math.random() * (this.width - 40) + 20,\n                y: Math.random() * (this.height - 40) + 20,\n                vx: (Math.random() - 0.5) * speedScale * 0.85,\n                vy: (Math.random() - 0.5) * speedScale * 0.85,\n                radius: 7.5 * radiusScale, // Larger visually, indicating density\n                maxRadius: 0, // Cannot explode\n                color: chosenColor,\n                state: \'DRIFTING\',\n                type: \'DECAY\',\n                timer: 0\n            });\n        }\n        \n        this.started = true;\n        this.onScoreUpdate(this.getStats());\n        this.loop();\n    }"
