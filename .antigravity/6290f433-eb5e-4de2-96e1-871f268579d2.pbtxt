        }
        lines {
          text: "                "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                if (p.y < p.radius) { p.y = p.radius; p.vy = Math.abs(p.vy); }"
