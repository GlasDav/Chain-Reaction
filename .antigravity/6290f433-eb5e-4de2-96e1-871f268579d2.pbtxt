        }
        lines {
          text: "            for (let i = 0; i < lineCount; i++) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                const angleOffset = (i * Math.PI * 2) / lineCount + this.orbitAngle;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
