        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        // DIFFICULTY UPGRADES: Scaling up velocity vectors and shrinking hitbox radius at higher levels"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        // Base starting velocity multiplier increases with level, making herding and timing much faster!"
