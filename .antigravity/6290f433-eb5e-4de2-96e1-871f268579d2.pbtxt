        }
        lines {
          text: "                if (dist < 180) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    const power = (1 - dist / 180) * 0.22;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    p.vx += (dx / dist) * power;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    p.vy += (dy / dist) * power;"
