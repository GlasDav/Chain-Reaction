          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    const distSq = dx*dx + dy*dy;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    const dist = Math.sqrt(distSq || 1);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    if (dist < 160) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        const pullPower = (1 - dist / 160) * 18 * (this.magnetFuel / 100);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        drawX -= (dx / dist) * pullPower;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        drawY -= (dy / dist) * pullPower;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
