                         className=\"w-full bg-[#1a1a1e] text-white py-4 rounded-xl font-bold text-lg flex items-center justify-center gap-2 border border-white/5 hover:bg-[#222228] active:scale-95 transition-all\"\n                            >\n                                <Share2 className=\"w-5 h-5\" /> SHARE SCORE\n                            </button>\n                        </div>\n                    </div>\n                )}\n                \n                {/* The physics-enabled canvas layer - visibility controlled to preserve bounds without ref loss */}\n                <canvas \n                    ref={canvasRef} \n                    className=\"w-full h-full flex-grow block touch-none bg-gradient-to-b from-[#0c0c0e] via-[#111116] to-[#0c0c0e]\""
