          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            for (let p of this.particles) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                if (p.state !== \'DRIFTING\') continue;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
