          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                // Restrict velocities to avoid chaotic zooming"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                const speedSq = p.vx * p.vx + p.vy * p.vy;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                if (speedSq > 2.5 * 2.5) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    p.vx *= 0.95;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    p.vy *= 0.95;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                // Canvas edge rebounding"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                if (p.x < p.radius) { p.x = p.radius; p.vx = Math.abs(p.vx); }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                else if (p.x > this.width - p.radius) { p.x = this.width - p.radius; p.vx = -Math.abs(p.vx); }"
