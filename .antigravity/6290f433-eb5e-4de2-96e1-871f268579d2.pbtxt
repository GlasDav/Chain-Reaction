        lines {
          text: "    const progressCirc = 2 * Math.PI * progressRadius; // 138.2"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const strokeOffset = progressCirc - (targetProgressSq / 100) * progressCirc;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
