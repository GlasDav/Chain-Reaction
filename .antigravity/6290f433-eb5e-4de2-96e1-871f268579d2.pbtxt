        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        // DIFFICULTY UPGRADES: Scaling up velocity vectors and shrinking hitbox radius at higher levels"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        // Base starting velocity multiplier increases with level, making herding and timing much faster!"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        const speedScale = 1.35 + Math.min(2.1, (level - 1) * 0.18);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        const radiusScale = Math.max(0.68, 1.0 - (level - 1) * 0.035);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        const activeThemeName = this.activeTheme || \'STANDARD\';"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        const currentThemeColors = THEME_COLORS[activeThemeName] || THEME_COLORS.STANDARD;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
