        }
        lines {
          text: "            let pType: ParticleType = \'STANDARD\';"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            if (randType < specialFreq) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                pType = \'GRAVITY\';"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            } else if (randType < specialFreq * 2) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                pType = \'SPLITTER\';"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
