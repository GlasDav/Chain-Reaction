          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    if (gp.type === \'GRAVITY\' && (gp.state === \'EXPANDING\' || gp.state === \'FROZEN\')) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        const dx = x - gp.x;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
