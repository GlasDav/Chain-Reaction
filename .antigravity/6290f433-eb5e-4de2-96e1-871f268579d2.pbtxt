        }
        lines {
          text: "                const dy = p.y - s.y;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                if (dx*dx + dy*dy < (p.radius + 12) * (p.radius + 12)) {"
