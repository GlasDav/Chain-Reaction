        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        // 5. Normal collision checks (Drifting vs Active Explosive Hubs)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        const explosives = this.particles.filter(p => "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            p.state === \'EXPANDING\' || p.state === \'FROZEN\' || p.state === \'SHRINKING\'"
