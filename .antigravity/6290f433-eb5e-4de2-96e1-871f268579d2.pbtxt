        }
        lines {
          text: "                    p.radius = p.maxRadius;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    p.state = \'FROZEN\';"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
