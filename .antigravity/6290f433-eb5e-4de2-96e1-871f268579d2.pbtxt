        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        // 1. Spawn clearable goal particles"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        for (let i = 0; i < this.totalDrifting; i++) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            // Special particle spawns: base is 15%. Volatility injector upgrade increases rate up to 25% each!"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            const specialFreq = 0.15 + (this.upgrades.specialSpawnRate || 0) * 0.05;"
