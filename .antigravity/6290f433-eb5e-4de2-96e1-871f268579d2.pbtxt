          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                // Gravity pull within local orbit"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                for (let other of this.particles) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
