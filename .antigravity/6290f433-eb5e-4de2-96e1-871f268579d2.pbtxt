          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            const chosenColor = selectionColors[Math.floor(Math.random() * selectionColors.length)];"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
