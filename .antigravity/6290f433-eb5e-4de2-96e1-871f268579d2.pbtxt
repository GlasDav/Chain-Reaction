          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                else if (p.y > this.height - p.radius) { p.y = this.height - p.radius; p.vy = -Math.abs(p.vy); }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            } else if (p.state === \'EXPANDING\') {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                p.radius += (p.maxRadius - 4) / EXPAND_FRAMES;"
