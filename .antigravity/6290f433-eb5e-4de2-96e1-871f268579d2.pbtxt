    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { useEffect, useRef, useState, PointerEvent } from \'react\';\nimport { GameEngine, GameStats } from \'./lib/engine\';\nimport { initAudio } from \'./lib/audio\';\nimport { Share2, Play, RotateCcw, Magnet, Zap, HelpCircle } from \'lucide-react\';\n\ntype Screen = \'START\' | \'GAME\' | \'ROUND_OVER\';\n\nexport default function App() {\n    const [screen, setScreen] = useState<Screen>(\'START\');\n    const [showHelp, setShowHelp] = useState(false);\n    \n    // Persistent stats\n    const [level, setLevel] = useState(1);\n    const [totalScore, setTotalScore] = useState(0);\n    const [peakCombo, setPeakCombo] = useState(0);\n    const [highScore, setHighScore] = useState(() => {\n        try {\n            const saved = localStorage.getItem(\'chain_reaction_high_score_v2\');\n            return saved ? parseInt(saved, 10) : 0;\n        } catch {\n            return 0;\n        }\n    });\n    \n    // Dynamic live reporting stats from engine\n    const [liveStats, setLiveStats] = useState<GameStats | null>(null);\n    const [didWinLast, setDidWinLast] = useState(false);\n    \n    const canvasRef = useRef<HTMLCanvasElement>(null);\n    const engineRef = useRef<GameEngine | null>(null);\n\n    // Pointer coordinates refs to distinguish a quick tap vs dragging herding\n    const pointerDownRef = useRef(false);\n    const startPosRef = useRef({ x: 0, y: 0, time: 0 });\n\n    const handleScoreUpdate = (stats: GameStats) => {\n        setLiveStats(stats);\n    };\n\n    const handleRoundEnd = (win: boolean, stats: GameStats) => {\n        setDidWinLast(win);\n        setPeakCombo(prev => Math.max(prev, stats.maxCombo));\n        if (win) {\n            setTotalScore(prev => {\n                // Score metric: 100 points per cleared, 50 points per combo peak\n                const scoreGain = stats.cleared * 100 + stats.maxCombo * 50;\n                const nextScore = prev + scoreGain;\n                if (nextScore > highScore) {\n                    setHighScore(nextScore);\n                    try {\n                        localStorage.setItem(\'chain_reaction_high_score_v2\', nextScore.toString());\n                    } catch (e) {\n                        console.error(e);\n                    }\n                }\n                return nextScore;\n            });\n        }\n        setScreen(\'ROUND_OVER\');\n    };\n\n    useEffect(() => {\n        if (screen === \'GAME\' && canvasRef.current) {\n            engineRef.current = new GameEngine(\n                canvasRef.current, \n                handleScoreUpdate, \n                handleRoundEnd\n            );\n            engineRef.current.startLevel(level);\n        }\n        \n        return () => {\n            if (engineRef.current) {\n                engineRef.current.destroy();\n                engineRef.current = null;\n            }\n        };\n    }, [screen, level]);\n\n    const startGame = () => {\n        initAudio(); // Initialize sound synthesis securely on main player interaction\n        if (screen === \'ROUND_OVER\' && !didWinLast) {\n            setLevel(1);\n            setTotalScore(0);\n            setPeakCombo(0);\n        } else if (screen === \'ROUND_OVER\' && didWinLast) {\n            setLevel(l => l + 1);\n        }\n        setScreen(\'GAME\');\n    };\n\n    // Advanced Input Handling coordinate calculations\n    const handlePointerDown = (e: PointerEvent<HTMLCanvasElement>) => {\n        if (!engineRef.current || liveStats?.tapped) return;\n        const rect = e.currentTarget.getBoundingClientRect();\n        \n        // Calculate coordinate translations correctly\n        const x = e.clientX - rect.left;\n        const y = e.clientY - rect.top;\n\n        pointerDownRef.current = true;\n        startPosRef.current = { x, y, time: Date.now() };\n\n        // Start local gravitational vortex at click position\n        engineRef.current.setMagnet(x, y, true);\n    };\n\n    const handlePointerMove = (e: PointerEvent<HTMLCanvasElement>) => {\n        if (!pointerDownRef.current || !engineRef.current) return;\n        const rect = e.currentTarget.getBoundingClientRect();\n        const x = e.clientX - rect.left;\n        const y = e.clientY - rect.top;\n\n        // Shift active magnet coordinate center\n        engineRef.current.setMagnet(x, y, true);\n    };\n\n    const handlePointerUp = (e: PointerEvent<HTMLCanvasElement>) => {\n        if (!pointerDownRef.current || !engineRef.current) return;\n        pointerDownRef.current = false;\n        \n        // Disable magnet on release\n        engineRef.current.setMagnet(0, 0, false);\n\n        const rect = e.currentTarget.getBoundingClientRect();\n        const x = e.clientX - rect.left;\n        const y = e.clientY - rect.top;\n\n        const duration = Date.now() - startPosRef.current.time;\n        const dx = x - startPosRef.current.x;\n        const dy = y - startPosRef.current.y;\n        const dist = Math.sqrt(dx*dx + dy*dy);\n\n        // A quick press with minimal hand jitter denotes deployment of trigger spark\n        if (duration < 240 && dist < 12) {\n            engineRef.current.dropTriggerSpark(x, y);\n        }\n    };\n\n    const handlePointerLeave = () => {\n        if (pointerDownRef.current && engineRef.current) {\n            pointerDownRef.current = false;\n            engineRef.current.setMagnet(0, 0, false);\n        }\n    };\n\n    // Drop detonator at current center coords in case of accessibility button click\n    const deployManualSpark = () => {\n        if (!engineRef.current || !canvasRef.current || liveStats?.tapped) return;\n        const halfWidth = canvasRef.current.width / (2 * (window.devicePixelRatio || 1));\n        const halfHeight = canvasRef.current.height / (2 * (window.devicePixelRatio || 1));\n        engineRef.current.dropTriggerSpark(halfWidth, halfHeight);\n    };\n\n    const shareScore = () => {\n        const text = `I hit a ${peakCombo}x COMBO with a Score of ${totalScore} on Chain Reaction! Can you handle the chaos? \360\237\222\245`;\n        if (navigator.clipboard) {\n            navigator.clipboard.writeText(text).then(() => {\n                alert(\"Score copied! Share on social media!\");\n            });\n        }\n    };\n\n    // Circle progress indicators setup parameters matching design specs\n    const targetProgressSq = liveStats ? Math.min(100, Math.round((liveStats.cleared / liveStats.totalRequired) * 100)) : 0;\n    const progressRadius = 22;\n    const progressCirc = 2 * Math.PI * progressRadius; // 138.2\n    const strokeOffset = progressCirc - (targetProgressSq / 100) * progressCirc;\n\n    return (\n        <div className=\"flex flex-col md:flex-row items-center justify-center min-h-screen bg-[#050505] text-white selection:bg-none p-4 font-sans gap-8\">\n            \n            {/* Left Column: Tactical Game Dashboard Window */}\n            <div className=\"w-full max-w-[380px] h-[80vh] min-h-[640px] border-[12px] border-[#1a1a1e] rounded-[48px] overflow-hidden relative shadow-2xl bg-[#0c0c0e] flex flex-col\">\n                <div className=\"h-6 w-32 bg-[#1a1a1e] absolute top-0 left-1/2 -translate-x-1/2 rounded-b-2xl z-50 pointer-events-none\"></div>\n                \n                {screen === \'START\' && (\n                    <div className=\"absolute inset-0 flex flex-col items-center justify-center p-8 text-center z-10 bg-[#0c0c0e]/95 backdrop-blur-sm\">\n                        <div className=\"mb-4 inline-flex items-center justify-center bg-cyan-900/20 text-cyan-400 border border-cyan-500/30 p-3 rounded-full animate-pulse shadow-[0_0_15px_rgba(34,211,238,0.2)]\">\n                            <Magnet className=\"w-8 h-8\" />\n                        </div>\n                        <h1 className=\"text-5xl font-black italic mb-2 tracking-tighter bg-gradient-to-br from-cyan-400 via-fuchsia-500 to-yellow-400 text-transparent bg-clip-text drop-shadow-[0_0_15px_rgba(34,211,238,0.3)] leading-none text-center\">\n                            CHAIN<br/>REACTION\n                        </h1>\n                        <p className=\"text-zinc-500 text-xs tracking-widest uppercase mb-12 font-bold\">VORTEX EXPANSION EDITION</p>\n                        \n                        <div className=\"space-y-4 w-full mb-8\">\n                            <button \n                                onClick={startGame}\n                                className=\"w-full bg-white text-black py-4 rounded-xl font-bold text-lg flex items-center justify-center gap-2 hover:scale-105 active:scale-95 transition-all shadow-[0_0_25px_rgba(255,255,255,0.25)]\"\n                            >\n                                <Play className=\"w-5 h-5 fill-black\" />\n                                START ENGINE\n                            </button>\n                            \n                            <button \n                                onClick={() => setShowHelp(!showHelp)}\n                                className=\"w-full bg-[#16161a] border border-zinc-800 text-zinc-300 py-3.5 rounded-xl text-sm font-semibold flex items-center justify-center gap-1.5 hover:bg-zinc-800 active:scale-98 transition-all\"\n                            >\n                                <HelpCircle className=\"w-4 h-4\" />\n                                {showHelp ? \'HIDE SCI-OPS MANUAL\' : \'VIEW SCI-OPS MANUAL\'}\n                            </button>\n                        </div>\n\n                        {/* Top Score banner inside Start View */}\n                        <div className=\"text-center\">\n                            <span className=\"block text-[10px] text-zinc-500 uppercase tracking-widest font-black\">RECORD STANDING</span>\n                            <span className=\"text-2xl font-black font-mono text-cyan-400\">{highScore.toLocaleString()} pts</span>\n                        </div>\n                    </div>\n                )}\n\n                {/* Live Gameplay Header HUD */}\n                {screen === \'GAME\' && liveStats && (\n                    <div className=\"absolute top-10 left-0 right-0 px-6 pointer-events-none z-40 flex justify-between items-center drop-shadow-md\">\n                        <div className=\"flex flex-col\">\n                            <span className=\"text-[10px] uppercase tracking-widest text-zinc-500 font-bold\">Level</span>\n                            <span className=\"text-2xl font-black text-white\">{liveStats.level.toString().padStart(2, \'0\')}</span>\n                        </div>\n\n                        {/* Highly responsive radial percentage indicator derived from prototype specs */}\n                        <div className=\"flex flex-col items-center\">\n                            <div className=\"w-14 h-14 rounded-full border-4 border-zinc-900/80 flex items-center justify-center relative bg-slate-950/80\">\n                                <svg className=\"absolute inset-0 w-full h-full -rotate-90\">\n                                    <circle \n                                        cx=\"24\" \n                                        cy=\"24\" \n                                        r=\"22\" \n                                        fill=\"transparent\" \n                                        stroke=\"#1e293b\" \n                                        strokeWidth=\"4\"\n                                    />\n                                    <circle \n                                        cx=\"24\" \n                                        cy=\"24\" \n                                        r=\"22\" \n                                        fill=\"transparent\" \n                                        stroke={targetProgressSq >= 100 ? \'#22c55e\' : \'#22d3ee\'} \n                                        strokeWidth=\"4\"\n                                        strokeDasharray={progressCirc}\n                                        strokeDashoffset={strokeOffset}\n                                        strokeLinecap=\"round\"\n                                        style={{ transition: \'stroke-dashoffset 0.35s ease\' }}\n                                    />\n                                </svg>\n                                <span className={`text-sm font-black ${targetProgressSq >= 100 ? \'text-green-400\' : \'text-cyan-400\'}`}>\n                                    {targetProgressSq}%\n                                </span>\n                            </div>\n                            <span className=\"text-[8px] uppercase tracking-widest mt-1 text-zinc-400 font-bold\">\n                                Target: {liveStats.totalRequired}\n                            </span>\n                        </div>\n\n                        <div className=\"flex flex-col items-end\">\n                            <span className=\"text-[10px] uppercase tracking-widest text-zinc-500 font-bold\">Cleared</span>\n                            <span className=\"text-2xl font-black text-cyan-400\">\n                                {liveStats.cleared}<span className=\"text-xs font-normal text-zinc-500\">/{liveStats.totalParticles}</span>\n                            </span>\n                        </div>\n                    </div>\n                )}\n\n                {/* State Tracking Guidance overlays */}\n                {screen === \'GAME\' && liveStats && (\n                    <div className=\"absolute top-28 left-0 right-0 text-center pointer-events-none z-10\">\n                        {liveStats.combo > 1 && (\n                            <span className=\"inline-block text-3xl font-black text-yellow-400 italic tracking-tighter uppercase drop-shadow-[0_0_10px_rgba(250,204,21,0.7)] animate-bounce\">\n                                {liveStats.combo}x Combo!\n                            </span>\n                        )}\n                    </div>\n                )}\n\n                {/* Active Interactive UI Panel for herder states */}\n                {screen === \'GAME\' && liveStats && (\n                    <div className=\"absolute bottom-28 left-0 right-0 px-6 py-2 flex flex-col gap-1 pointer-events-none z-40 text-center items-center\">\n                        {!liveStats.tapped ? (\n                            <div className=\"w-full flex flex-col items-center bg-slate-950/70 border border-white/5 p-3 rounded-2xl backdrop-blur-md\">\n                                <div className=\"flex justify-between w-full items-center mb-1 bg-none\">\n                                    <span className=\"text-[9px] uppercase tracking-widest text-yellow-400 font-bold flex items-center gap-1\">\n                                        <Magnet className=\"w-3 h-3 text-yellow-400\" /> GRAVITY SWEEPER CHARGE\n                                    </span>\n                                    <span className=\"text-xs font-mono font-bold text-yellow-400\">{liveStats.magnetFuel}%</span>\n                                </div>\n                                <div className=\"w-full h-1.5 bg-zinc-800 rounded-full overflow-hidden\">\n                                    <div \n                                        className=\"h-full bg-gradient-to-r from-yellow-500 to-orange-500 transition-all duration-75\"\n                                        style={{ width: `${liveStats.magnetFuel}%` }}\n                                    />\n                                </div>\n                                <span className=\"text-[8px] text-zinc-400 mt-1 uppercase font-bold leading-none tracking-wide text-center\">\n                                    Drag to sweep & cluster. Quick click to detonate.\n                                </span>\n                            </div>\n                        ) : (\n                            <div className=\"inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-cyan-950/40 border border-cyan-800/30 backdrop-blur-md text-[10px] font-bold text-cyan-300 uppercase tracking-widest animate-pulse\">\n                                <Zap className=\"w-3 h-3 text-cyan-400 fill-cyan-400\" /> Watch cascade Reaction\n                            </div>\n                        )}\n                    </div>\n                )}\n\n                {/* Round Over Screen Display state matching specs */}\n                {screen === \'ROUND_OVER\' && liveStats && (\n                    <div className=\"absolute inset-0 flex flex-col items-center justify-center p-8 text-center z-40 bg-[#0c0c0e]/95 backdrop-blur-lg\">\n                        <div className=\"mb-4 inline-flex items-center justify-center p-3 rounded-full border\">\n                            {didWinLast ? (\n                                <div className=\"bg-lime-900/20 text-lime-400 border-lime-500/30 p-2 rounded-full\">\n                                    <Zap className=\"w-8 h-8 text-lime-400 fill-lime-400\" />\n                                </div>\n                            ) : (\n                                <div className=\"bg-rose-900/20 text-rose-400 border-rose-500/30 p-2 rounded-full\">\n                                    <RotateCcw className=\"w-8 h-8 text-rose-400\" />\n                                </div>\n                            )}\n                        </div>\n                        \n                        <h2 className={`text-4xl font-black italic tracking-tighter uppercase leading-none mb-1 ${didWinLast ? \'text-lime-400 drop-shadow-[0_0_15px_rgba(163,230,53,0.4)]\' : \'text-rose-500 drop-shadow-[0_0_15px_rgba(244,63,94,0.4)]\'}`}>\n                            {didWinLast ? \'LEVEL CLEARED!\' : \'TACTICAL FAULT!\'}\n                        </h2>\n                        \n                        <p className=\"text-zinc-500 text-xs font-bold leading-tight max-w-[240px] mb-8\">\n                            {didWinLast \n                                ? `Success! Heavy systemic sequence cascade completed.` \n                                : `Reaction died prior to clearance objective. Required: ${liveStats.totalRequired}.`}\n                        </p>\n\n                        <div className=\"grid grid-cols-2 gap-4 w-full mb-8\">\n                            <div className=\"p-3.5 rounded-2xl bg-white/5 border border-white/10 flex flex-col items-center\">\n                                <span className=\"block text-[8px] font-bold text-zinc-500 uppercase tracking-widest\">CLEARED SCORE</span>\n                                <span className=\"text-2xl font-black text-cyan-400\">+{liveStats.cleared * 100}</span>\n                            </div>\n                            <div className=\"p-3.5 rounded-2xl bg-white/5 border border-white/10 flex flex-col items-center\">\n                                <span className=\"block text-[8px] font-bold text-zinc-500 uppercase tracking-widest\">PEAK COMBO</span>\n                                <span className=\"text-2xl font-black text-yellow-400 italic font-mono\">{liveStats.maxCombo}x</span>\n                            </div>\n                        </div>\n\n                        <div className=\"flex flex-col w-full gap-3\">\n                            <button \n                                onClick={startGame}\n                                className=\"w-full bg-white text-black py-4 rounded-xl font-bold text-base flex items-center justify-center gap-2 hover:scale-105 active:scale-95 transition-all shadow-[0_0_20px_rgba(255,255,255,0.15)]\"\n                            >\n                                {didWinLast ? (\n                                    <>\n                                        <Play className=\"w-5 h-5 fill-black\" /> PROCEED TO LEVEL {level + 1}\n                                    </>\n                                ) : (\n                                    <>\n                                        <RotateCcw className=\"w-5 h-5\" /> RE-ENGAGE SEQUENCE\n                                    </>\n                                )}\n                            </button>\n                            \n                            <button \n                                onClick={shareScore}\n                                className=\"w-full bg-zinc-900 text-zinc-300 py-3 rounded-xl font-bold text-sm flex items-center justify-center gap-2 border border-zinc-800 hover:bg-zinc-800 active:scale-95 transition-all\"\n                            >\n                                <Share2 className=\"w-4 h-4\" /> TRANSMIT DATA COMMS\n                            </button>\n                        </div>\n                    </div>\n                )}\n                \n                {/* Active Interactive Physics Rendering Surface */}\n                <canvas \n                    ref={canvasRef} \n                    className=\"w-full h-full flex-grow block touch-none cursor-pointer\"\n                    onPointerDown={handlePointerDown}\n                    onPointerMove={handlePointerMove}\n                    onPointerUp={handlePointerUp}\n                    onPointerLeave={handlePointerLeave}\n                    style={{ visibility: screen === \'START\' ? \'hidden\' : \'visible\' }}\n                />\n\n                {/* Bottom Dock Control dashboard matching precise palette */}\n                <div className=\"h-24 px-6 flex items-center justify-between gap-4 bg-[#111114] border-t border-zinc-900 relative z-40\">\n                    <div className=\"flex-1 flex flex-col justify-center\">\n                        <span className=\"text-[10px] uppercase font-bold text-zinc-500\">SCORE</span>\n                        <span className=\"text-xl font-black text-white leading-none font-mono tracking-tight\">{totalScore.toLocaleString()}</span>\n                    </div>\n                    {screen === \'GAME\' && liveStats && !liveStats.tapped && (\n                        <button \n                            onClick={deployManualSpark}\n                            className=\"bg-cyan-500 hover:bg-cyan-400 text-black px-4 py-2.5 rounded-lg text-xs font-black tracking-wider uppercase flex items-center gap-1 shadow-[0_0_15px_rgba(34,211,238,0.4)] transition-all pointer-events-auto active:scale-95\"\n                        >\n                            <Zap className=\"w-3.5 h-3.5 fill-black\" /> DROP SPARK\n                        </button>\n                    )}\n                </div>\n                \n                <div className=\"absolute bottom-2 left-1/2 -translate-x-1/2 w-32 h-1 bg-white/20 rounded-full\"></div>\n            </div>\n\n            {/* Right Column: Dynamic Tactical Manual explaining elements (satisfying requirements!) */}\n            <div className=\"w-full max-w-[380px] space-y-4\">\n                <div className=\"p-6 rounded-[36px] bg-[#0c0c0e] border border-zinc-800/80 shadow-xl flex flex-col relative overflow-hidden\">\n                    <div className=\"absolute top-0 right-0 w-24 h-24 bg-cyan-500/5 rounded-full blur-2xl pointer-events-none\"></div>\n                    <div className=\"absolute bottom-0 left-0 w-24 h-24 bg-fuchsia-500/5 rounded-full blur-2xl pointer-events-none\"></div>\n                    \n                    <h2 className=\"text-lg font-black text-white italic tracking-tight mb-1 bg-gradient-to-r from-cyan-400 to-fuchsia-400 text-transparent bg-clip-text\">\n                        SCI-OPS TACTICAL DIRECTIVE\n                    </h2>\n                    <p className=\"text-xs text-zinc-400 mb-4 leading-relaxed\">\n                        This sequence model measures precision grouping and kinetic triggering. Follow nodes below to guarantee optimal chain reaction payloads.\n                    </p>\n\n                    <div className=\"space-y-3 font-sans text-xs\">\n                        <div className=\"flex gap-3 items-start p-2.5 rounded-xl bg-white/5 border border-white/5\">\n                            <span className=\"flex-shrink-0 w-6 h-6 rounded-full bg-[#e879f9]/20 border border-[#e879f9]/50 flex items-center justify-center text-xs text-[#e879f9] font-black\">\n                                \360\237\237\243\n                            </span>\n                            <div>\n                                <h4 className=\"font-bold text-[#e879f9] tracking-tight uppercase text-[10px]\">Gravity Pulse Core</h4>\n                                <p className=\"text-[11px] text-zinc-300 leading-normal\">Pulls all shifting atoms closely toward itself during execution. Creates robust cascading points.</p>\n                            </div>\n                        </div>\n\n                        <div className=\"flex gap-3 items-start p-2.5 rounded-xl bg-white/5 border border-white/5\">\n                            <span className=\"flex-shrink-0 w-6 h-6 rounded-full bg-[#facc15]/20 border border-[#facc15]/50 flex items-center justify-center text-xs text-[#facc15] font-black\">\n                                \360\237\237\241\n                            </span>\n                            <div>\n                                <h4 className=\"font-bold text-[#facc15] tracking-tight uppercase text-[10px]\">Cross Star Splitter</h4>\n                                <p className=\"text-[11px] text-zinc-300 leading-normal\">Detonates into an 8-axis laser surge comet swarm, igniting volatile elements across long distances.</p>\n                            </div>\n                        </div>\n\n                        <div className=\"flex gap-3 items-start p-2.5 rounded-xl bg-white/5 border border-white/5\">\n                            <span className=\"flex-shrink-0 w-6 h-6 rounded-full bg-cyan-400/20 border border-cyan-400/50 flex items-center justify-center text-xs text-cyan-400 font-bold\">\n                                \360\237\237\242\n                            </span>\n                            <div>\n                                <h4 className=\"font-bold text-cyan-400 tracking-tight uppercase text-[10px]\">Standard Element</h4>\n                                <p className=\"text-[11px] text-zinc-300 leading-normal\">Slow drifting molecular spheres. Bounce off spatial boundaries but trigger instant shockwaves.</p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                <div className=\"flex gap-4\">\n                    <div className=\"flex-1 p-4 rounded-3xl bg-[#0c0c0e] border border-zinc-800/80 text-center\">\n                        <span className=\"block text-[9px] font-bold text-zinc-500 uppercase tracking-widest mb-0.5\">Top Combo</span>\n                        <span className=\"text-xl font-black text-yellow-500 italic font-mono\">{peakCombo || \'---\'}X</span>\n                    </div>\n                    <div className=\"flex-1 p-4 rounded-3xl bg-[#0c0c0e] border border-zinc-800/80 text-center\">\n                        <span className=\"block text-[9px] font-bold text-zinc-500 uppercase tracking-widest mb-0.5\">Peak Score</span>\n                        <span className=\"text-xl font-black text-cyan-400 font-mono\">{highScore ? highScore.toLocaleString() : \'---\'}</span>\n                    </div>\n                </div>\n            </div>\n\n        </div>\n    );\n}\n"
