        }
        lines {
          text: "                else if (p.y > this.height - p.radius) { p.y = this.height - p.radius; p.vy *= -1; }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            } else if (p.state === \'EXPANDING\') {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                p.radius += (p.maxRadius - 4) / EXPAND_FRAMES;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                if (p.radius >= p.maxRadius) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    p.radius = p.maxRadius;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    p.state = \'FROZEN\';"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    p.timer = FREEZE_FRAMES;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            } else if (p.state === \'FROZEN\') {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                p.timer--;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
