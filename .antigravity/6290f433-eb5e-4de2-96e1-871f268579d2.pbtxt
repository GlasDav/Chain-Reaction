          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                y: p.y,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                vx: Math.cos(angle) * speed,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                vy: Math.sin(angle) * speed,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                life: 1.0,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                color: p.color"
